@page
@model CityBreaks.Web.Pages.CreatePropertyModel
@{
    ViewData["Title"] = "Nova propriedade";
}

<div class="container mt-4">
    <h2>Cadastrar Nova Propriedade Turística</h2>
    <hr />

    <div class="row">
        <div class="col-md-6">
            <form method="post">
                <div class="form-group mb-3">
                    <label class="control-label">Nome do Estabelecimento</label>
                    <input asp-for="NovaPropriedade.Name" class="form-control" placeholder="Ex: Hotel Fazenda..." required />
                </div>

                <div class="form-group mb-3">
                    <label class="control-label">Preço por Noite (R$)</label>
                    <input asp-for="NovaPropriedade.PricePerNight" class="form-control" type="number" step="0.01" required />
                </div>

                <div class="form-group mb-4">
                    <label class="control-label">Cidade Destino</label>
                    <select asp-for="NovaPropriedade.CityId" asp-items="Model.CidadesList" class="form-select" required>
                        <option value="">-- Selecione uma Cidade --</option>
                    </select>
                </div>

                <button type="submit" class="btn btn-success">Salvar Cadastro</button>
                <a asp-page="/Index" class="btn btn-outline-secondary ms-2">Cancelar</a>
            </form>
        </div>
    </div>
</div>